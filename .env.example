# Copy to .env and fill in. Never commit .env. Never paste real values into issues, PRs or chat.

# --- Database (local Docker Postgres on 127.0.0.1:5433; NOT the live Railway DB) ---
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and can hang.
POSTGRES_USER=inventorymantra
POSTGRES_PASSWORD=inventorymantra_dev
POSTGRES_DB=inventorymantra
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://inventorymantra:inventorymantra_dev@127.0.0.1:5433/inventorymantra
# Tests and evals use a separate database, recreated by `make test-db`. Default: the name above
# plus "_test". Set this only to use another one; its name must end in "_test".
# TEST_DATABASE_URL=
# Password for the read-only role users rms_im_ro / rms_pm_ro / rms_owner_ro (agent SQL runs as these).
# Required: without it they stay NOLOGIN and the RBAC tests skip.
READONLY_DB_PASSWORD=choose-a-long-random-string
# Source DB used only by the one-off export script (database.py). Leave blank unless re-exporting.
SOURCE_DATABASE_URL=

# --- Auth ---
DEMO_PASSWORD=               # password for the 3 demo users; if blank, `make seed` generates one and prints it once
JWT_SECRET_KEY=generate-with-python-secrets-token_urlsafe-64   # exact name; >= 32 chars or login is disabled
COOKIE_SECURE=false          # true in deployment (HTTPS only cookies)

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_REASONING=gpt-4.1-mini-2025-04-14   # SQL + answers; dated id = no silent drift (D-003)
OPENAI_MODEL_FAST=gpt-4.1-mini-2025-04-14        # guard / clarify / viz

LLM_MODE=fake                # fake = scripted offline models (no spend) | openai = real calls
OPENAI_DAILY_TOKEN_BUDGET=200000   # hard cap; LLM calls are refused beyond it

# --- LangSmith tracing ---
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=inventorymantra-dev

# --- App ---
APP_TODAY=                   # optional frozen date (YYYY-MM-DD); evals use 2026-09-30
PO_APPROVAL_THRESHOLD_INR=100000

# --- Voice input (C8.1) ---
# Optional. Without a key the browser's own speech recognition is used (Chrome / Edge).
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3           # default
# DEEPGRAM_LANGUAGE=multi         # default: English / Hindi code-switching; try en-IN if English is misheard

# --- Web app (read by Next.js from frontend/.env.local, not from this file) ---
# Where the web server proxies /api/* (D-037). The browser never calls the API directly.
# API_INTERNAL_URL=http://127.0.0.1:8000
